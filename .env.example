# =================================
# MyVocab Backend Environment Configuration
# =================================

# Server Configuration
NODE_ENV=dev
PORT=3000

# =================================
# Database Configuration
# =================================

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/myvocab
MONGO_DB_NAME=myvocab

# Redis Configuration (for session management)
REDIS_URL=redis://localhost:6379

# =================================
# JWT Configuration
# =================================

# JWT Access Token Secret (Change this in production!)
ACCESS_TOKEN_SECRET_KEY=your-super-secret-access-token-key-change-this-in-production

# JWT Refresh Token Secret (Change this in production!)
REFRESH_TOKEN_SECRET_KEY=your-super-secret-refresh-token-key-change-this-in-production

# =================================
# Email Configuration
# =================================

# Email Service Provider: Resend
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key

# =================================
# Application Configuration
# =================================

# Application Base URL (used for email verification links)
APP_URL=http://localhost:3000

# =================================
# CORS Configuration (Development)
# =================================

# Frontend URLs (comma-separated)
FRONTEND_URLS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# =================================
# Security Configuration
# =================================

# Enable/Disable specific security features
ENABLE_RATE_LIMITING=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =================================
# File Upload Configuration (Optional)
# =================================

# Maximum file size for uploads (in bytes)
MAX_FILE_SIZE=5242880

# Allowed file types for vocabulary audio
ALLOWED_AUDIO_TYPES=audio/mpeg,audio/wav,audio/mp3

# =================================
# Logging Configuration
# =================================

# Log Level (error, warn, info, debug)
LOG_LEVEL=info

# Enable/Disable specific logs
ENABLE_ACCESS_LOGS=true
ENABLE_ERROR_LOGS=true

# =================================
# Production Only Configuration
# =================================

# SSL Configuration (Production)
SSL_KEY_PATH=/path/to/ssl/private.key
SSL_CERT_PATH=/path/to/ssl/certificate.crt

# Database Connection Pool (Production)
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=5

# Redis Connection Pool (Production)
REDIS_MAX_CONNECTIONS=10

# =================================
# Development Only Configuration
# =================================

# Enable development features
ENABLE_SWAGGER=true
ENABLE_MORGAN_LOGGING=true
ENABLE_DETAILED_ERRORS=true

# =================================
# Instructions
# =================================

# 1. Copy this file to .env: cp .env.example .env
# 2. Update the values according to your environment
# 3. Never commit the actual .env file to version control
# 4. Make sure to change JWT secrets in production
# 5. Get a Resend API key from https://resend.com
# 6. Ensure MongoDB and Redis are running before starting the app
#
# Required for development:
# - MONGO_URI
# - REDIS_URL  
# - ACCESS_TOKEN_SECRET_KEY
# - REFRESH_TOKEN_SECRET_KEY
# - RESEND_API_KEY (for email features)
#
# Optional for development:
# - All other variables have sensible defaults
